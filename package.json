{
  "name": "aura-flow-assistant",
  "private": true,
  "version": "1.0.0",
  "description": "Jerry personal AI assistant",
  "author": "Jerry Assistant",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test:routing": "node --test server/*.test.js",
    "desktop:dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\" \"wait-on http://localhost:5173 && electron .\"",
    "desktop:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.jerry.assistant",
    "productName": "Jerry",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "server/**/*", "electron/**/*", "package.json"]
  }
}
